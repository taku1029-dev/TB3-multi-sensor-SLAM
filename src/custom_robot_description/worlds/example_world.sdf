<?xml version="1.0" ?>

<sdf version="1.10">
	<world name="example_world">

		<!-- Physics parameter -->
		<physics name="1ms" type="ignored">
			<max_step_size>0.001</max_step_size>
			<real_time_factor>1.0</real_time_factor>
		</physics>

		<!-- Plugins -->
		<!-- General -->
		<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
		<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
		<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
		<!-- Sensors -->
		<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
		<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>

		<light type="directional" name="sun">
			<cast_shadows>true</cast_shadows>
			<pose>0 0 10 0 0 0</pose>
			<diffuse>0.8 0.8 0.8 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
				<constant>0.9</constant>
				<linear>0.01</linear>
				<quadratic>0.001</quadratic>
			</attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>

		<model name="ground_plane">
			<static>true</static>
			<link name="link">
				<collision name="collision">
					<geometry>
						<plane>
							<normal>0 0 1</normal>
							<size>100 100</size>
						</plane>
					</geometry>
				</collision>
				<visual name="visual">
					<geometry>
						<plane>
							<normal>0 0 1</normal>
							<size>100 100</size>
						</plane>
					</geometry>
					<material>
						<ambient>0.8 0.8 0.8 1</ambient>
						<diffuse>0.8 0.8 0.8 1</diffuse>
						<specular>0.8 0.8 0.8 1</specular>
					</material>
				</visual>
			</link>
		</model>

		<!-- Training arena: 10x10 m enclosure + interior obstacles.
		     Designed so /lidar produces meaningful sector variance and partial
		     blockage signals for ADR-008 Block A features (which would otherwise
		     all saturate in an empty world). Robot spawns at (0,0,0); 1 m of
		     clearance around spawn keeps reset() collision-free. -->

		<model name="wall_north">
			<static>true</static>
			<pose>0 5 0.25 0 0 0</pose>
			<link name="link">
				<collision name="collision">
					<geometry><box><size>10 0.1 0.5</size></box></geometry>
				</collision>
				<visual name="visual">
					<geometry><box><size>10 0.1 0.5</size></box></geometry>
					<material>
						<ambient>0.5 0.5 0.5 1</ambient>
						<diffuse>0.7 0.7 0.7 1</diffuse>
					</material>
				</visual>
			</link>
		</model>

		<model name="wall_south">
			<static>true</static>
			<pose>0 -5 0.25 0 0 0</pose>
			<link name="link">
				<collision name="collision">
					<geometry><box><size>10 0.1 0.5</size></box></geometry>
				</collision>
				<visual name="visual">
					<geometry><box><size>10 0.1 0.5</size></box></geometry>
					<material>
						<ambient>0.5 0.5 0.5 1</ambient>
						<diffuse>0.7 0.7 0.7 1</diffuse>
					</material>
				</visual>
			</link>
		</model>

		<model name="wall_east">
			<static>true</static>
			<pose>5 0 0.25 0 0 0</pose>
			<link name="link">
				<collision name="collision">
					<geometry><box><size>0.1 10 0.5</size></box></geometry>
				</collision>
				<visual name="visual">
					<geometry><box><size>0.1 10 0.5</size></box></geometry>
					<material>
						<ambient>0.5 0.5 0.5 1</ambient>
						<diffuse>0.7 0.7 0.7 1</diffuse>
					</material>
				</visual>
			</link>
		</model>

		<model name="wall_west">
			<static>true</static>
			<pose>-5 0 0.25 0 0 0</pose>
			<link name="link">
				<collision name="collision">
					<geometry><box><size>0.1 10 0.5</size></box></geometry>
				</collision>
				<visual name="visual">
					<geometry><box><size>0.1 10 0.5</size></box></geometry>
					<material>
						<ambient>0.5 0.5 0.5 1</ambient>
						<diffuse>0.7 0.7 0.7 1</diffuse>
					</material>
				</visual>
			</link>
		</model>

		<model name="pillar_ne">
			<static>true</static>
			<pose>1.5 2.0 0.25 0 0 0</pose>
			<link name="link">
				<collision name="collision">
					<geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
				</collision>
				<visual name="visual">
					<geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
					<material>
						<ambient>0.6 0.2 0.2 1</ambient>
						<diffuse>0.8 0.2 0.2 1</diffuse>
					</material>
				</visual>
			</link>
		</model>

		<model name="pillar_se">
			<static>true</static>
			<pose>1.0 -2.0 0.25 0 0 0</pose>
			<link name="link">
				<collision name="collision">
					<geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
				</collision>
				<visual name="visual">
					<geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
					<material>
						<ambient>0.2 0.5 0.2 1</ambient>
						<diffuse>0.2 0.7 0.2 1</diffuse>
					</material>
				</visual>
			</link>
		</model>

		<model name="pillar_sw">
			<static>true</static>
			<pose>-2.0 -1.5 0.25 0 0 0</pose>
			<link name="link">
				<collision name="collision">
					<geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
				</collision>
				<visual name="visual">
					<geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
					<material>
						<ambient>0.2 0.2 0.6 1</ambient>
						<diffuse>0.2 0.2 0.8 1</diffuse>
					</material>
				</visual>
			</link>
		</model>

		<model name="box_nw">
			<static>true</static>
			<pose>-2.0 2.0 0.25 0 0 0</pose>
			<link name="link">
				<collision name="collision">
					<geometry><box><size>0.4 0.4 0.5</size></box></geometry>
				</collision>
				<visual name="visual">
					<geometry><box><size>0.4 0.4 0.5</size></box></geometry>
					<material>
						<ambient>0.6 0.6 0.2 1</ambient>
						<diffuse>0.8 0.8 0.2 1</diffuse>
					</material>
				</visual>
			</link>
		</model>
	</world>
</sdf>

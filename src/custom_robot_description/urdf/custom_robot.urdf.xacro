<?xml version="1.0" encoding="UTF-8"?>
<robot name="custom_robot" xmlns:xacro="http://ros.org/wiki/xacro">

	<xacro:include filename="$(find custom_robot_description)/urdf/turtlebot3_burger.urdf.xacro"/>
	<!-- 2. Change where import from -->
	<!-- <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/> -->
	<xacro:include filename="$(find custom_robot_description)/urdf/_d435.urdf.xacro"/>

	<xacro:sensor_d435 parent="base_link" use_nominal_extrinsics="true">
		<origin xyz="0.010 0.0 0.140" rpy="0 0 0"/>
		<!-- 1. Separate from body -->
		<!-- Seems fine, to be removed soon -->
		<!-- <origin xyz="0.10 0.0 0.20" rpy="0 0 0"/> -->
	</xacro:sensor_d435>

	<!-- attach sensor to the camera -->
	<gazebo reference="camera_depth_optical_frame">
		<sensor name="d435_sensor" type="rgbd_camera">
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<always_on>1</always_on>
			<update_rate>10</update_rate>
			<topic>camera/rgbd</topic>
			<visualize>false</visualize>
			<camera name="rgbd_camera">
				<horizontal_fov>1.5917</horizontal_fov>
				<image>
					<width>1280</width>
					<height>720</height>
					<format>R8G8B8</format>
				</image>
				<clip>
					<!-- Too near(0.01) -> affected by frame -->
					<near>0.105</near>
					<far>8.0</far>
				</clip>
			</camera>
		</sensor>
	</gazebo>

	<gazebo reference="base_scan">
		<sensor name="LDS-02" type="gpu_lidar">
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<always_on>true</always_on>
			<update_rate>10</update_rate>
			<visualize>false</visualize>
			<topic>lidar</topic>
			<!-- Pin frame_id to "base_scan" (the URDF link) so slam_toolbox can
			     transform scans into base_footprint via robot_state_publisher's TF. -->
			<gz_frame_id>base_scan</gz_frame_id>
			<lidar>
				<scan>
					<horizontal>
						<samples>360</samples>
						<resolution>1</resolution>
						<min_angle>0.0</min_angle>
						<max_angle>6.28319</max_angle>
					</horizontal>
					<vertical>
						<samples>1</samples>
						<resolution>1</resolution>
						<min_angle>0.0</min_angle>
						<max_angle>0.0</max_angle>
					</vertical>
				</scan>
				<range>
					<min>0.16</min>
					<max>8.0</max>
					<resolution>0.015</resolution>
				</range>
			</lidar>
		</sensor>
	</gazebo>

	<!-- IMU sensor must be wrapped in <gazebo reference="LINK"><sensor>...</sensor></gazebo>
	     (matches the lidar block above). The earlier <gazebo name=... type="imu"> form is
	     not the schema gz-sim expects, so the sensor was never instantiated. -->
	<gazebo reference="imu_link">
		<sensor name="imu-sensor" type="imu">
			<always_on>true</always_on>
			<update_rate>100</update_rate>
			<visualize>false</visualize>
			<topic>imu</topic>
			<!-- gz-sim defaults to "<model>/<link>/<sensor>" for header.frame_id;
			     pin to plain "imu_link" so it matches the URDF link name. -->
			<gz_frame_id>imu_link</gz_frame_id>
			<imu/>
		</sensor>
	</gazebo>

	<gazebo reference="wheel_left_link">
		<mu1>1.0</mu1>
		<mu2>1.0</mu2>
		<kp>1000000.0</kp>
		<kd>100.0</kd>
		<minDepth>0.001</minDepth>
		<material>Gazebo/DarkGrey</material>
	</gazebo>

	<gazebo reference="wheel_right_link">
		<mu1>1.0</mu1>
		<mu2>1.0</mu2>
		<kp>1000000.0</kp>
		<kd>100.0</kd>
		<minDepth>0.001</minDepth>
		<material>Gazebo/DarkGrey</material>
	</gazebo>

	<gazebo reference="caster_back_link">
		<mu1>0.0</mu1>
		<mu2>0.0</mu2>
		<kp>1000000.0</kp>
		<kd>100.0</kd>
		<minDepth>0.001</minDepth>
		<material>Gazebo/FlatBlack</material>
	</gazebo>

	<gazebo reference="wheel_left_joint">
		<implicitSpringDamper>true</implicitSpringDamper>
		<provideFeedback>true</provideFeedback>
	</gazebo>

	<gazebo reference="wheel_right_joint">
		<implicitSpringDamper>true</implicitSpringDamper>
		<provideFeedback>true</provideFeedback>
	</gazebo>

	<gazebo>
		<!-- Environmental Setup -->
		<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
			<left_joint>wheel_left_joint</left_joint>
			<right_joint>wheel_right_joint</right_joint>
			<wheel_separation>0.160</wheel_separation>
			<wheel_radius>0.033</wheel_radius>
			<odom_publish_frequency>30</odom_publish_frequency>
			<topic>cmd_vel</topic>
			<odom_topic>odom_wheel</odom_topic>
			<!-- Override gz-sim's default model-prefixed frame names so EKF yaml's
			     odom_frame:"odom" / base_link_frame:"base_footprint" match. -->
			<frame_id>odom</frame_id>
			<child_frame_id>base_footprint</child_frame_id>
		</plugin>

		<plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
			<topic>model/custom_robot/joint_state</topic>
			<joint_name>wheel_left_joint</joint_name>
			<joint_name>wheel_right_joint</joint_name>
		</plugin>

		<!-- Sim-only ground-truth pose for ADR-005 reward (`-|EKF_pose - GT_pose| * 10`).
		     Defaults publish a Pose_V of every link/collision/visual; we want just the model
		     pose so the bridge maps cleanly to a single geometry_msgs/PoseStamped on
		     /model/custom_robot/pose (remapped to /ground_truth_pose in the launch). -->
		<plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
			<publish_link_pose>false</publish_link_pose>
			<publish_sensor_pose>false</publish_sensor_pose>
			<publish_collision_pose>false</publish_collision_pose>
			<publish_visual_pose>false</publish_visual_pose>
			<publish_nested_model_pose>false</publish_nested_model_pose>
			<publish_model_pose>true</publish_model_pose>
			<use_pose_vector_msg>false</use_pose_vector_msg>
			<update_frequency>30</update_frequency>
		</plugin>

	</gazebo>
</robot>
